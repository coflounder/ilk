{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ilk hook run session-start --target codex",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ilk hook run turn-end --target codex",
            "type": "command"
          }
        ]
      }
    ]
  }
}
