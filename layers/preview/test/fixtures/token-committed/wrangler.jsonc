{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "<your-account-id>",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "shop.example.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<production-access-aud>",
    // The Access application on this Worker's preview URLs.
    "ACCESS_AUD_PREVIEW": "<preview-access-aud>",
  },
}
